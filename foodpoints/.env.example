# FoodPoints — Umgebungsvariablen (Referenz; Werte NIE committen)
#
# Ohne Supabase-Variablen läuft die App automatisch im Demo-Modus
# (lokale Daten im Browser, kein Login nötig).

# --- Supabase (Auth, DB, Storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only! Niemals im Client verwenden.
SUPABASE_SERVICE_ROLE_KEY=

# --- Basis-URL der App (für Auth-Redirects, Metadaten) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Vision / Fotoerkennung ---
# "mock" = MockVisionProvider (kein externer Dienst, deterministische Testdaten)
# "claude" = Anthropic Claude Vision (benötigt VISION_API_KEY)
VISION_PROVIDER=mock
VISION_MODEL=claude-sonnet-5
# Server-only! Niemals im Client verwenden.
VISION_API_KEY=

# --- Lebensmittel-Datenbank (Barcode-Suche) ---
# "openfoodfacts" = Open Food Facts API (kein Key nötig)
# "mock" = deterministische Testdaten
FOOD_DATA_PROVIDER=openfoodfacts

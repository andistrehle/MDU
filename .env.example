# ============================================================
# MDU Platform — Environment-Variablen (Vorlage)
# ============================================================
# Kopieren nach .env.local und Werte eintragen.
# .env.local NIEMALS committen (enthält Secrets).
#
# Die Werte findest du im Supabase-Dashboard unter:
#   Project Settings → API
# ============================================================

# Supabase-Projekt-URL, z. B. https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Öffentlicher anon key (NICHT der service_role key!)
# Der service_role key gehört niemals ins Frontend / in NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Basis-URL der Live-Seite (für robots.txt & sitemap.xml).
# Ohne diesen Wert wird ein Fallback verwendet.
NEXT_PUBLIC_SITE_URL=

# Optional, nur für lokale Entwicklung OHNE Supabase:
# Aktiviert den Auth-Dev-Mock (keine echte Anmeldung, Rolle aus
# E-Mail-Präfix). Standard ist echte Supabase-Auth.
# NEXT_PUBLIC_USE_AUTH_MOCK=true

# ============================================================
# E-Mail-Benachrichtigungen (NUR serverseitig — KEIN NEXT_PUBLIC!)
# ============================================================
# Diese Variablen werden ausschließlich im Server-Code gelesen
# (Route Handler / Server-Utility) und niemals an den Browser gesendet.
# Sind sie nicht gesetzt, werden E-Mails sauber übersprungen
# (Status "skipped_no_provider") — es wird kein Versand vorgetäuscht.

# Resend API Key (https://resend.com → API Keys)
RESEND_API_KEY=

# Absenderadresse, z. B. no-reply@mucdartunion.de (Domain muss bei Resend verifiziert sein)
EMAIL_FROM=

# Supabase service_role Key — NUR serverseitig, für System-Schreibzugriffe
# (z. B. email_logs). NIEMALS ins Frontend / in NEXT_PUBLIC_* aufnehmen.
# Ohne diesen Key wird das E-Mail-Log übersprungen, der Versand läuft trotzdem.
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# OCR / Vision — Papier-Spielbericht hochladen & erkennen (NUR serverseitig)
# ============================================================
# Alle OCR-Variablen werden ausschließlich im Server-Code (Route Handler)
# gelesen — niemals NEXT_PUBLIC_*. Ohne Konfiguration ist das Feature aus
# und die manuelle Erfassung funktioniert wie bisher.

# Feature-Schalter. Standard: aus. Auf 'true' setzen, um den OCR-Upload
# freizuschalten (zusätzlich muss Migration 0023 ausgeführt sein).
OCR_FEATURE_ENABLED=

# Rollen, die hochladen/prüfen dürfen (Komma-getrennt). Für engen Pilotstart
# z. B. nur 'super_admin'. Standard, falls leer:
# team_captain,league_admin,super_admin
OCR_ALLOWED_ROLES=

# Provider-Auswahl: 'claude' (Claude Vision), 'stub' (Testdaten ohne Kosten/Key),
# oder leer (= nicht konfiguriert). Standard: claude.
OCR_PROVIDER=

# API-Key des Vision-Providers (für 'claude': Anthropic-Key). Server-only.
# Alternativ wird ANTHROPIC_API_KEY verwendet, falls OCR_API_KEY leer ist.
OCR_API_KEY=
# ANTHROPIC_API_KEY=

# Modell-ID (für 'claude'), z. B. claude-sonnet-4-6 (Pilot) oder
# claude-opus-4-8 (max. Genauigkeit). Standard: claude-sonnet-4-6.
OCR_MODEL=

# Maximale Dateigröße je Upload in MB. Standard: 12.
OCR_MAX_FILE_SIZE_MB=

# ── Cron (Vercel) ─────────────────────────────────────────────
# Geheimnis, mit dem Vercel-Cron die geschützten Cron-Routen aufruft
# (z. B. /api/cron/draft-reminders). Vercel sendet es automatisch als
# "Authorization: Bearer <CRON_SECRET>", sobald es als Projekt-ENV gesetzt ist.
# Server-only, langer Zufallswert. Ohne diesen Wert lehnt die Route JEDE Anfrage ab.
CRON_SECRET=

# Teams, die NICHT automatisch an ihren Anmeldungs-Entwurf erinnert werden sollen
# (z. B. bereits manuell angeschrieben). Komma-getrennte Teamnamen, exakt wie in
# der Anmeldung. Beispiel: DRAFT_REMINDER_SKIP=Lucky Darts One,Funny Darters Munich
DRAFT_REMINDER_SKIP=
